# Copia este archivo como .env y descomenta lo que quieras cambiar.
# Todas las variables son opcionales: sin .env la API usa los valores de abajo.

# Entorno: development, testing o production
# ENVIRONMENT=development

# Base de datos (SQLite por defecto; PostgreSQL: postgresql://usuario:clave@localhost/musica)
# DATABASE_URL=sqlite:///./musica.db

# Orígenes permitidos por CORS (lista en formato JSON)
# CORS_ORIGINS=["http://localhost:3000"]

# Logging: DEBUG, INFO, WARNING, ERROR o CRITICAL (en development el valor por defecto es DEBUG)
# LOG_LEVEL=INFO
# Archivo de log rotativo (opcional; en production es logs/musica_api.log)
# LOG_FILE=logs/musica_api.log

# Servidor, solo al ejecutar con: python main.py
# HOST=0.0.0.0
# PORT=8000
# DEBUG=true
